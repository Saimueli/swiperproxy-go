FROM golang:1.22-alpine AS builder
WORKDIR /build
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /swiperproxy-go ./cmd/swiperproxy

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /swiperproxy-go /usr/local/bin/swiperproxy-go
COPY configs/ /etc/swiperproxy-go/
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/swiperproxy-go", "/etc/swiperproxy-go/config.yaml"]